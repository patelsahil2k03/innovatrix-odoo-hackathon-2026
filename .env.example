# TransitOps — copy to .env (defaults work out of the box for local dev)
# Backend reads backend/.env or environment; frontend reads frontend/.env.local
# scripts/dev.sh propagates this root file to both automatically.

# --- Database ---
# Default: Postgres via infra/docker-compose.yml
DATABASE_URL=postgresql+psycopg://transitops:transitops@localhost:5432/transitops
# No Docker? Comment the line above and uncomment this one instead — fully tested, no other
# changes needed (migrations + seed + API all work against it identically):
# DATABASE_URL=sqlite:///./transitops.db
POSTGRES_USER=transitops
POSTGRES_PASSWORD=transitops
POSTGRES_DB=transitops
POSTGRES_PORT=5432

# --- API ---
# 44+ chars so HS256 doesn't warn about a short key. Dev-only value — rotate for any real deploy.
JWT_SECRET=dev-only-insecure-default-please-rotate-me
SIMULATOR_ENABLED=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
